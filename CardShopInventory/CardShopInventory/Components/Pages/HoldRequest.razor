@page "/hold/{ItemId:int}"
@using System.ComponentModel.DataAnnotations
@using CardShopInventory.Models
@using CardShopInventory.Services
@inject IInventoryService InventoryService
@inject IReservationService ReservationService
@rendermode InteractiveServer

<PageTitle>Request Hold</PageTitle>

@if (item is null && !notFound)
{
    <p><em>Loading...</em></p>
}
else if (notFound)
{
    <p>Item not found.</p>
    <a href="/">Back to inventory</a>
}
else if (submitted)
{
    <div class="alert alert-success">
        Your hold request for <strong>@item!.Name</strong> has been submitted. The shop will contact you at
        <strong>@Input.CustomerContact</strong> to confirm.
    </div>
    <a href="/" class="btn btn-secondary">Back to inventory</a>
}
else
{
    <h1>Request Hold</h1>
    <div class="mb-3">
        @if (!string.IsNullOrEmpty(item!.ImagePath))
        {
            <img src="@item.ImagePath" style="height:120px" alt="@item.Name" />
        }
        <h4>@item.Name</h4>
        <p>@item.GetDetails()</p>
        <p>Price: @item.Price.ToString("C") | In stock: @item.Quantity</p>
    </div>

    <EditForm Model="Input" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Your Name</label>
            <InputText class="form-control" @bind-Value="Input.CustomerName" />
        </div>
        <div class="mb-3">
            <label>Phone or Email</label>
            <InputText class="form-control" @bind-Value="Input.CustomerContact" />
        </div>
        <div class="mb-3">
            <label>Quantity</label>
            <InputNumber class="form-control" @bind-Value="Input.Quantity" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button class="btn btn-primary" type="submit">Submit Hold Request</button>
        <a href="/" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public int ItemId { get; set; }

    private InventoryItem? item;
    private bool notFound;
    private bool submitted;
    private string? errorMessage;
    private HoldInput Input = new();

    protected override async Task OnInitializedAsync()
    {
        item = await InventoryService.GetByIdAsync(ItemId);
        if (item is null)
        {
            notFound = true;
        }
    }

    private async Task Submit()
    {
        if (item is null) return;

        if (Input.Quantity > item.Quantity)
        {
            errorMessage = $"Only {item.Quantity} in stock.";
            return;
        }

        await ReservationService.CreateAsync(item.Id, Input.CustomerName, Input.CustomerContact, Input.Quantity);
        submitted = true;
    }

    private class HoldInput
    {
        [Required, StringLength(100)]
        public string CustomerName { get; set; } = string.Empty;

        [Required, StringLength(150)]
        public string CustomerContact { get; set; } = string.Empty;

        [Range(1, 1000)]
        public int Quantity { get; set; } = 1;
    }
}