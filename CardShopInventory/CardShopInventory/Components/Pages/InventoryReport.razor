@page "/admin/reports"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CardShopInventory.Models
@using CardShopInventory.Services
@inject IInventoryService InventoryService
@rendermode InteractiveServer

<PageTitle>Inventory Report</PageTitle>

<h1>Inventory Report</h1>
<p>Generated: @generatedAt.ToString("f")</p>

@if (items is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Type</th>
                <th>Name</th>
                <th>Details</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Date Added</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@(item is Card ? "Trading Card" : "Sealed Product")</td>
                    <td>@item.Name</td>
                    <td>@item.GetDetails()</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>@item.DateAdded.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Totals</th>
                <th>@totalValue.ToString("C")</th>
                <th>@totalQuantity</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}

@code {
    private List<InventoryItem>? items;
    private DateTime generatedAt = DateTime.Now;
    private decimal totalValue;
    private int totalQuantity;

    protected override async Task OnInitializedAsync()
    {
        items = await InventoryService.SearchAllAsync(null);
        totalValue = items.Sum(i => i.Price * i.Quantity);
        totalQuantity = items.Sum(i => i.Quantity);
    }
}