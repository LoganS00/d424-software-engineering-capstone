@page "/"
@using CardShopInventory.Models
@using CardShopInventory.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IInventoryService InventoryService
@inject ICardService CardService
@inject ISealedProductService ProductService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Card Inventory</PageTitle>

<h1>Card Shop Inventory</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width:400px"
           placeholder="Search by name, set, number, manufacturer..."
           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearch" />
    <AuthorizeView>
        <Authorized>
            <button class="btn btn-primary" @onclick="AddCard">+ Add Card</button>
            <button class="btn btn-primary" @onclick="AddProduct">+ Add Sealed Product</button>
        </Authorized>
    </AuthorizeView>
</div>

@if (items is null)
{
    <p><em>Loading...</em></p>
}
else if (items.Count == 0)
{
    <p>No inventory found.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Type</th>
                <th>Details</th>
                <th>Price</th>
                <th>Qty</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in PagedItems)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" style="height:60px" alt="@item.Name" />
                        }
                    </td>
                    <td>@item.Name</td>
                    <td>@(item is Card ? "Trading Card" : "Sealed Product")</td>
                    <td>@item.GetDetails()</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>
                        @if (item is Card)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="/hold/@item.Id">Request Hold</a>
                        }
                    </td>
                    <td>
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-sm btn-secondary" @onclick="() => Edit(item)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Delete(item)">Delete</button>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage <= 1)" @onclick="PrevPage">Previous</button>
        <span>Page @currentPage of @TotalPages (@items.Count total items)</span>
        <button class="btn btn-outline-secondary btn-sm" disabled="@(currentPage >= TotalPages)" @onclick="NextPage">Next</button>
    </div>
}

@code {
    private List<InventoryItem>? items;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private const int PageSize = 10;

    private int TotalPages => items is null ? 1 : Math.Max(1, (int)Math.Ceiling(items.Count / (double)PageSize));

    private IEnumerable<InventoryItem> PagedItems =>
        items is null ? Enumerable.Empty<InventoryItem>() : items.Skip((currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => items = await InventoryService.SearchAllAsync(searchTerm);

    private async Task OnSearch(KeyboardEventArgs e)
    {
        currentPage = 1;
        await Load();
    }

    private void PrevPage()
    {
        if (currentPage > 1) currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }

    private void AddCard() => Nav.NavigateTo("/card/new");
    private void AddProduct() => Nav.NavigateTo("/product/new");

    private void Edit(InventoryItem item)
    {
        if (item is Card)
            Nav.NavigateTo($"/card/{item.Id}");
        else
            Nav.NavigateTo($"/product/{item.Id}");
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private async Task Delete(InventoryItem item)
    {
        var authState = AuthStateTask is null ? null : await AuthStateTask;
        if (authState?.User.Identity?.IsAuthenticated != true) return;

        if (item is Card)
            await CardService.DeleteAsync(item.Id);
        else
            await ProductService.DeleteAsync(item.Id);

        await Load();
    }
}